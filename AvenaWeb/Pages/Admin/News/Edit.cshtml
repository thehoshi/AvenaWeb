@page "{id:int?}"
@model AvenaWeb.Pages.Admin.News.EditModel
@{
    ViewData["Title"] = Model.Article == null ? "Create news article" : "Edit news article"; ViewData["I18nTitle"] = Model.Article == null ? "admin.create_article" : "admin.edit_article";
}
<link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
<section class="admin-page section-inner">
    <div class="admin-header">
        <div>
            <a class="admin-back-link" asp-page="./Index" data-i18n="admin.back">← All articles</a>
            <p class="eyebrow" data-i18n="admin.newsroom">Avena newsroom</p><h1 data-i18n="@(Model.Article == null ? "admin.create_article" : "admin.edit_article")">@(Model.Article == null ? "Create article" : "Edit article")</h1>
            @if (Model.Article != null)
            {
                <p><span data-i18n="admin.current_status">Current status:</span> <span class="admin-status @Model.Status" data-i18n="admin.status.@Model.Status">@Model.Status</span></p>
            }
        </div>
    </div>
    <form id="newsEditor" class="admin-editor" method="post" data-news-id="@Model.Id">
        @Html.AntiForgeryToken()
        <div class="admin-form-grid">
            <div class="admin-field admin-field-wide"><label for="newsTitle" data-i18n="admin.headline">Headline *</label><input id="newsTitle" maxlength="240" required value="@Model.Article?.Title" autocomplete="off" /></div>
            <div class="admin-field"><label for="newsSlug" data-i18n="admin.slug">URL slug</label><input id="newsSlug" maxlength="180" value="@Model.Article?.Slug" autocomplete="off" /><small data-i18n="admin.slug_help">Generated from the headline; edit with letters, numbers, and hyphens.</small></div>
            <div class="admin-field"><label for="newsGenre" data-i18n="admin.topic">Topic *</label><select id="newsGenre" required><option value="" data-i18n="admin.choose_topic">Choose a topic</option>@foreach (var genre in Model.Genres) {
                <option value="@genre.ID" data-genre="@genre.NameGenre" selected="@(Model.Article?.GenreID == genre.ID ? "selected" : null)">@genre.NameGenre</option>
            }
        </select><details class="admin-topic-creator" id="topicCreatorDetails"><summary class="admin-inline-button" data-i18n="admin.add_topic">+ Add topic</summary><div class="admin-inline-create" id="topicCreator"><label for="newTopicName" data-i18n="admin.new_topic">New topic name</label><div class="admin-inline-row"><input id="newTopicName" maxlength="80" /><button type="button" class="btn-secondary" id="createTopic" data-i18n="admin.create_topic">Create topic</button></div></div></details></div>
        <div class="admin-field"><label for="newsAuthor" data-i18n="admin.byline">Byline</label><input id="newsAuthor" maxlength="160" value="@Model.Article?.Author?.FullName" placeholder="Type an author name (optional)" data-i18n-placeholder="admin.author_placeholder" /></div>
        <div class="admin-field admin-field-wide"><label for="newsSummary" data-i18n="admin.summary">Summary</label><textarea id="newsSummary" rows="3" maxlength="320">@Model.Article?.Summary</textarea><small data-i18n="admin.summary_help">Optional short text for article cards.</small></div>
        <div class="admin-field admin-field-wide"><label for="newsImageFile" data-i18n="admin.cover_image">Cover image</label><input id="newsImage" type="hidden" value="@Model.Article?.Image" /><input id="newsImageFile" type="file" accept="image/png,image/jpeg,image/webp" /><small data-i18n="admin.cover_image_help">Choose a JPG, PNG, or WebP image from your device. Maximum 5 MB.</small><div id="imageUploadMessage" class="admin-upload-message" role="status" aria-live="polite"></div><img id="imagePreview" class="admin-image-preview" src="@Model.Article?.Image" alt="" hidden="@(string.IsNullOrWhiteSpace(Model.Article?.Image) ? "hidden" : null)" /></div>
        <div class="admin-field admin-field-wide"><label for="newsBody" data-i18n="admin.body">Article body (Markdown) *</label><textarea id="newsBody" rows="18" maxlength="100000" required>@Model.Article?.Info</textarea><small data-i18n="admin.body_help">Supports headings, paragraphs, lists, links, emphasis, and code blocks. Raw HTML is disabled.</small></div>
    </div>
    <div id="editorMessage" class="admin-alert" role="status" aria-live="polite" hidden></div>
    <div class="admin-actions">
        <button type="submit" class="btn-secondary" data-action="save" data-i18n="@(Model.Status == "published" ? "admin.save_live" : "admin.save_draft")">@(Model.Status == "published" ? "Save live changes" : "Save draft")</button>
        @if (Model.Status != "published")
        {
            <button type="submit" class="btn-primary" data-action="publish" data-i18n="admin.publish">Publish now</button>
        }
    </div>
</form>
</section>
<script src="~/js/admin-news.js" asp-append-version="true"></script>
