@page
@model ProfileModel

@{
    ViewData["Title"] = "Profile";
    ViewData["I18nTitle"] = "page.profile";
}

<section class="profile-page">
    <div class="section-inner">
        @if (Model.CurrentUser != null)
        {
            <div class="profile-card">
                @if (!string.IsNullOrEmpty(Model.CurrentUser.AvatarImg))
                {
                    <div class="profile-avatar" id="avatarPreview" style="background-image:url('@Model.CurrentUser.AvatarImg')"></div>
                }
                else
                {
                    <div class="profile-avatar" id="avatarPreview">@Model.CurrentUser.Name.Substring(0, 1).ToUpper()</div>
                }

                <h1>@Model.CurrentUser.Name</h1>
                <p class="profile-username">@@@Model.CurrentUser.Username</p>

                @if (!ModelState.IsValid)
                {
                    <p class="form-error">@ModelState.Values.SelectMany(v => v.Errors).FirstOrDefault()?.ErrorMessage</p>
                }

                <form method="post" class="profile-form">
                    <label for="name"><span data-i18n="profile.display_name">Display name</span></label>
                    <input type="text" id="name" name="name" value="@Model.CurrentUser.Name" required />

                    <button type="submit" class="btn-primary"><span data-i18n="profile.save">Save changes</span></button>
                </form>
            </div>
        }
    </div>
</section>
