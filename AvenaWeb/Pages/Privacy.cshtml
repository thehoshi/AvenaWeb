@page
@model PrivacyModel
@{
    ViewData["Title"] = "Privacy Policy";
    ViewData["I18nTitle"] = "page.privacy";
}

<section class="article-page">
    <div class="section-inner article-header">
        <h1 data-i18n="privacy.title">Privacy Policy</h1>
        <p class="article-meta" data-i18n="common.last_updated">Last updated: September 16, 2026</p>
    </div>

    <div class="section-inner article-body legal-content">
        <p data-i18n="privacy.intro">Avena ("we", "us") operates this website. This policy explains what information we collect and how we use it.</p>

        <h2 data-i18n="privacy.collect">Information We Collect</h2>
        <ul>
            <li data-i18n="privacy.account_data"><strong>Account data:</strong> username, display name, and password (stored hashed) when you register.</li>
            <li data-i18n="privacy.content_data"><strong>Content you submit:</strong> news posts, comments, and images you upload.</li>
            <li data-i18n="privacy.usage_data"><strong>Usage data:</strong> pages viewed, article view counts.</li>
            <li data-i18n="privacy.cookies"><strong>Cookies:</strong> we use a session cookie to keep you logged in.</li>
        </ul>

        <h2 data-i18n="privacy.use">How We Use Your Information</h2>
        <ul>
            <li data-i18n="privacy.use_account">To provide and maintain your account and let you post content.</li>
            <li data-i18n="privacy.use_display">To display your username alongside comments and posts you make.</li>
            <li data-i18n="privacy.use_improve">To improve the site's functionality.</li>
        </ul>

        <p data-i18n="privacy.no_sell">We do not sell your personal data to third parties.</p>

        <h2 data-i18n="privacy.retention">Data Retention</h2>
        <p><span data-i18n="privacy.retention_text">We retain your account and content data for as long as your account is active. You may request deletion by contacting us at</span> <a href="mailto:avenanews@gmail.com">avenanews@gmail.com</a>.</p>

        <h2 data-i18n="privacy.third_party">Third-Party Services</h2>
        <p data-i18n="privacy.third_party_text">Our site may link to third-party platforms (Instagram, TikTok). We are not responsible for their privacy practices.</p>

        <h2 data-i18n="privacy.rights">Your Rights</h2>
        <p><span data-i18n="privacy.rights_text">You may request access to, correction of, or deletion of your personal data at any time by contacting</span> <a href="mailto:avenanews@gmail.com">avenanews@gmail.com</a>.</p>

        <h2 data-i18n="common.contact">Contact</h2>
        <p><span data-i18n="privacy.contact_text">Questions about this policy? Contact us at</span> <a href="mailto:avenanews@gmail.com">avenanews@gmail.com</a>.</p>
    </div>
</section>
