@page
@model TermsModel
@{
    ViewData["Title"] = "Terms";
    ViewData["I18nTitle"] = "page.terms";
}

<section class="article-page">
    <div class="section-inner article-header">
        <h1 data-i18n="terms.title">Terms of Use</h1>
        <p class="article-meta" data-i18n="common.last_updated">Last updated: September 16, 2026</p>
    </div>

    <div class="section-inner article-body legal-content">
        <p data-i18n="terms.intro">By accessing Avena, you agree to these terms.</p>

        <h2 data-i18n="terms.accounts_title">1. Accounts</h2>
        <p data-i18n="terms.accounts_text">You must provide accurate information when registering. You are responsible for maintaining the security of your account.</p>

        <h2 data-i18n="terms.content_title">2. User Content</h2>
        <p data-i18n="terms.content_text">You retain ownership of content you post (articles, comments, images), but grant Avena a license to display it on the platform. You are solely responsible for what you post.</p>

        <h2 data-i18n="terms.prohibited_title">3. Prohibited Conduct</h2>
        <p data-i18n="terms.prohibited_text">You may not post content that is illegal, harassing, hateful, or infringes on others' rights. We reserve the right to remove content and suspend accounts that violate these terms.</p>

        <h2 data-i18n="terms.moderation_title">4. Content Moderation</h2>
        <p data-i18n="terms.moderation_text">We may review, edit, or remove any content at our discretion, though we do not guarantee active moderation of all posts.</p>

        <h2 data-i18n="terms.disclaimer_title">5. Disclaimer</h2>
        <p data-i18n="terms.disclaimer_text">Content on Avena reflects the opinions of individual authors and does not represent the views of Avena as a platform. We are not liable for inaccuracies in user-submitted content.</p>

        <h2 data-i18n="terms.changes_title">6. Changes to These Terms</h2>
        <p data-i18n="terms.changes_text">We may update these terms from time to time. Continued use of the site constitutes acceptance of the updated terms.</p>

        <h2 data-i18n="terms.contact_title">7. Contact</h2>
        <p><span data-i18n="terms.contact_text">Questions? Contact us at</span> <a href="mailto:avenanews@gmail.com">avenanews@gmail.com</a>.</p>
    </div>
</section>
