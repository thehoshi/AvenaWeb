@page
@model CreateNewsModel

@{
    ViewData["Title"] = "Create News";
}

<section class="profile-page">
    <div class="section-inner">
        <div class="profile-card wide">
            <h1>Write a new article</h1>
            <p class="profile-username">Share something with the community</p>

            @if (!ModelState.IsValid)
            {
                <p class="form-error">@ModelState.Values.SelectMany(v => v.Errors).FirstOrDefault()?.ErrorMessage</p>
            }

            <form method="post" enctype="multipart/form-data" class="profile-form">
                <label asp-for="Title">Title</label>
                <input asp-for="Title" required />

                <label asp-for="Info">Article text</label>
                <textarea asp-for="Info" rows="10" required></textarea>

                <label asp-for="ImageFile">Image</label>
                <input asp-for="ImageFile"
                       type="file"
                       accept=".jpg,.jpeg,.png,.webp" />

                <label asp-for="GenreName">Genre</label>
                <input asp-for="GenreName"
                       list="genreOptions"
                       placeholder="Type to search, or type a new genre name"
                       autocomplete="off"
                       required />
                <datalist id="genreOptions">
                    @foreach (var genre in Model.Genres)
                    {
                        <option value="@genre.NameGenre"></option>
                    }
                </datalist>

                <button type="submit" class="btn-primary">Publish article</button>
            </form>
        </div>
    </div>
</section>
