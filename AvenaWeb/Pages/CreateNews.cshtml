@page
@model CreateNewsModel

@{
    ViewData["Title"] = "Create News";
}

<h1>Create News</h1>

<form method="post" enctype="multipart/form-data">

    <div>
        <label asp-for="Title">Title</label>
        <input asp-for="Title" required />
    </div>

    <br />

    <div>
        <label asp-for="Info">Article text</label>
        <br />
        <textarea asp-for="Info"
                  rows="10"
                  cols="60"
                  required></textarea>
    </div>

    <br />

    <div>
        <label asp-for="ImageFile">Image</label>
        <input asp-for="ImageFile"
               type="file"
               accept=".jpg,.jpeg,.png,.webp" />
    </div>

    <br />

    <div>
        <label asp-for="GenreID">Genre</label>

        <select asp-for="GenreID"
                asp-items="@(new SelectList(Model.Genres, "ID", "NameGenre"))"
                required>
            <option value="">Select a genre</option>
        </select>
    </div>

    <br />

    <button type="submit">Create News</button>

</form>