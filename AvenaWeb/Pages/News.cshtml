@page "/news/{id:int}"
@model NewsModel

@{
    ViewData["Title"] = Model.News?.Title;
}

<article>
    <h1>@Model.News?.Title</h1>

    @if (Model.Genre != null)
    {
        <p>
            Genre:
            <a href="/genre/@Model.Genre.ID">
                @Model.Genre.NameGenre
            </a>
        </p>
    }

    @if (!string.IsNullOrEmpty(Model.News?.Image))
    {
        <img src="@Model.News.Image" alt="@Model.News.Title" />
    }

    <p>@Model.News?.Info</p>

    <section>
        <h2>Comments</h2>

        @if (!Model.Comments.Any())
        {
            <p>No comments yet.</p>
        }
        else
        {
            foreach (var comment in Model.Comments)
            {
                <article>
                    <p>@comment.Text</p>
                </article>
            }
        }
    </section>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <section>
            <h2>Leave a comment</h2>

            <form method="post">
                <input type="hidden" name="NewsId" value="@Model.News?.ID" />

                <textarea name="CommentText"
                          rows="5"
                          placeholder="Write your comment..."
                          required></textarea>

                <br />

                <button type="submit">Post comment</button>
            </form>
        </section>
    }
    else
    {
        <p>
            <a asp-page="/Login">Login</a> to leave a comment.
        </p>
    }

    <form method="post" asp-page-handler="Like">
        <input type="hidden" name="id" value="@Model.News?.ID" />

        <button type="submit">
            Like
        </button>
    </form>
</article>