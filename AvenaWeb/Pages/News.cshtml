@page "/news/{id:int}"
@model NewsModel

@{
    ViewData["Title"] = Model.News?.Title;
}

<section class="article-page">
    <div class="section-inner article-header">
        @if (Model.Genre != null)
        {
            <a href="/genre/@Model.Genre.ID" class="tag">@Model.Genre.NameGenre</a>
        }
        <h1>@Model.News?.Title</h1>
        @if (Model.News != null)
        {
            <p class="article-meta">@Model.News.DateOfPost.ToString("MMMM d, yyyy") · @Model.News.Views view@(Model.News.Views == 1 ? "" : "s")</p>
        }
    </div>

    @if (!string.IsNullOrEmpty(Model.News?.Image))
    {
        <div class="article-hero-image" style="background-image:url('@Model.News.Image')"></div>
    }

    <div class="section-inner article-body">
        <p>@Model.News?.Info</p>
    </div>

    <div class="section-inner comments-section">
        <h2>Comments</h2>

        @if (!Model.Comments.Any())
        {
            <p class="login-prompt">No comments yet — be the first to share your take.</p>
        }
        else
        {
            @foreach (var comment in Model.Comments)
            {
                <div class="comment-item">
                    <div class="avatar" aria-hidden="true">@comment.Username.Substring(0, 1).ToUpper()</div>
                    <div class="comment-item-body">
                        <strong>@comment.Username</strong>
                        <span class="comment-date">@comment.DateOfPost.ToString("MMMM d, yyyy")</span>
                        <p>@comment.Text</p>
                    </div>
                </div>
            }
        }

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="comment-form-section">
                <h2>Leave a comment</h2>

                <form method="post" class="comment-form" id="commentForm">
                    <input type="hidden" name="NewsId" value="@Model.News?.ID" />

                    <textarea name="CommentText"
                              id="commentText"
                              rows="4"
                              placeholder="Write your comment... (Enter to post, Shift+Enter for a new line)"
                              required></textarea>

                    <button type="submit" class="btn-primary">Post comment</button>
                </form>

                <script>
                                document.getElementById("commentText").addEventListener("keydown", function(event) {
                                    if (event.key === "Enter" && !event.shiftKey) {
                                        event.preventDefault();
                                        document.getElementById("commentForm").requestSubmit();
                                    }
                                });
                </script>
            </div>
        }
        else
        {
            <p class="login-prompt comment-form-section">
                <a asp-page="/Login">Login</a> to leave a comment.
            </p>
        }
    </div>
</section>
