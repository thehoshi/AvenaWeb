@page "/news/{id:int}"
@model NewsModel

@{
    ViewData["Title"] = Model.News?.Title;
}

<article>
    <h1>@Model.News?.Title</h1>

    @if (Model.Genre != null)
    {
        <p>
            Genre:
            <a href="/genre/@Model.Genre.ID">
                @Model.Genre.NameGenre
            </a>
        </p>
    }

    @if (!string.IsNullOrEmpty(Model.News?.Image))
    {
        <img src="@Model.News.Image" alt="@Model.News.Title" />
    }

    <p>@Model.News?.Info</p>

    <div>
        Views: @Model.News?.Views
        |
        Likes: @Model.News?.CountOfLikes
    </div>
</article>