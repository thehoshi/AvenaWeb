@page
@model RegisterModel

@{
    ViewData["Title"] = "Register";
}

<section class="profile-page">
    <div class="section-inner">
        <div class="profile-card">
            <h1>Join Avena</h1>
            <p class="profile-username">Create an account to comment and post</p>

            @{
                var formError = ModelState.ContainsKey("") ? ModelState[""]!.Errors.FirstOrDefault()?.ErrorMessage : null;
            }
            @if (formError != null)
            {
                <p class="form-error">@formError</p>
            }

            <form method="post" class="profile-form">
                <label asp-for="Username">Username</label>
                <input asp-for="Username" autocomplete="username" required />
                <span asp-validation-for="Username" class="validation-message"></span>

                <label asp-for="Name">Name</label>
                <input asp-for="Name" autocomplete="name" required />
                <span asp-validation-for="Name" class="validation-message"></span>

                <label asp-for="Password">Password</label>
                <input asp-for="Password" type="password" autocomplete="new-password" required />
                <span asp-validation-for="Password" class="validation-message"></span>

                <button type="submit" class="btn-primary">Register</button>
            </form>

            <p class="auth-switch">
                Already have an account? <a asp-page="/Login">Login</a>
            </p>
        </div>
    </div>
</section>
