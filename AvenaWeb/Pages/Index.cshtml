@page
@model IndexModel
@{
    ViewData["Title"] = "Avena";
    var featured = Model.News.FirstOrDefault();
    var rest = Model.News.Skip(1).Take(6).ToList();
}

<link rel="stylesheet" href="~/css/Azpetrol.css" />

<!-- HERO -->
<section class="hero" id="home">
    <div class="hero-inner">
        <div class="hero-text">
            <p class="eyebrow">Est. 2026 — An open forum</p>
            <h1>Avena<br>Opinions</h1>
            <p class="hero-tagline">Opinions shape the future.<br>Stay informed. Stay engaged.</p>
            <a href="#news" class="btn-primary">Read Latest News</a>
        </div>
        <div class="hero-visual" aria-hidden="true">
            <div class="orbit-wrap">
                <div class="pulse-widget">
                    <span class="ring ring-1"></span>
                    <span class="ring ring-2"></span>
                    <span class="ring ring-3"></span>
                    <div class="pulse-core">
                        <span class="pulse-quote">&#8220;</span>
                    </div>
                </div>

                @{
                    var orbitGenres = Model.Genres.Take(8).ToList();
                }
                @for (int i = 0; i < orbitGenres.Count; i++)
                {
                    double angle = i * (360.0 / orbitGenres.Count);

                    <div class="orbit-item" style="--angle:@(angle.ToString(System.Globalization.CultureInfo.InvariantCulture))deg">
                        <span class="orbit-pill">@orbitGenres[i].NameGenre</span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<!-- ABOUT -->
<section class="about" id="about">
    <div class="section-inner about-grid">
        <div class="about-heading">
            <p class="eyebrow">About the Project</p>
            <h2>Why this platform exists</h2>
        </div>
        <div class="about-details">
            <div class="detail-row">
                <span class="detail-label">Who created it</span>
                <p>A small collective of writers, editors, and researchers who believe public debate deserves a calmer home.</p>
            </div>
            <div class="detail-row">
                <span class="detail-label">Mission</span>
                <p>To turn scattered reactions into informed conversation — one article at a time.</p>
            </div>
            <div class="detail-row">
                <span class="detail-label">Purpose</span>
                <p>A space where evidence and opinion sit side by side, so readers can weigh both before they speak.</p>
            </div>
            <div class="detail-row">
                <span class="detail-label">Year</span>
                <p>Founded in 2026, built for the conversations still ahead of us.</p>
            </div>
        </div>
    </div>
</section>

<!-- LATEST NEWS -->
<section class="news" id="news">
    <div class="section-inner">
        <p class="eyebrow">Latest News</p>
        <h2>What people are talking about</h2>

        @if (featured == null)
        {
            <p>No articles have been published yet. Check back soon.</p>
        }
        else
        {
            var featuredGenre = Model.Genres.FirstOrDefault(g => g.ID == featured.GenreID);
            var featuredExcerpt = featured.Info.Length > 220 ? featured.Info.Substring(0, 220).TrimEnd() + "…" : featured.Info;

            <article class="featured-article">
                @if (!string.IsNullOrEmpty(featured.Image))
                {
                    <div class="featured-image" style="background-image:url('@featured.Image'); background-size:cover; background-position:center; border-radius:4px;"></div>
                }
                else
                {
                    <div class="featured-image ph-img" data-label="Featured Image"></div>
                }
                <div class="featured-body">
                    @if (featuredGenre != null)
                    {
                        <span class="tag">@featuredGenre.NameGenre</span>
                    }
                    <h3>@featured.Title</h3>
                    <p>@featuredExcerpt</p>
                    <a href="/news/@featured.ID" class="read-more">Read More <span aria-hidden="true">→</span></a>
                </div>
            </article>

            @if (rest.Any())
            {
                <div class="news-grid">
                    @foreach (var news in rest)
                    {
                        var genre = Model.Genres.FirstOrDefault(g => g.ID == news.GenreID);

                        <article class="news-card">
                            @if (!string.IsNullOrEmpty(news.Image))
                            {
                                <div class="card-image" style="background-image:url('@news.Image'); background-size:cover; background-position:center; border-radius:4px;"></div>
                            }
                            else
                            {
                                <div class="card-image ph-img" data-label="Image"></div>
                            }
                            @if (genre != null)
                            {
                                <span class="tag">@genre.NameGenre</span>
                            }
                            <h4><a href="/news/@news.ID">@news.Title</a></h4>
                            <a href="/news/@news.ID" class="read-more">Read More <span aria-hidden="true">→</span></a>
                        </article>
                    }
                </div>
            }
        }
    </div>
</section>

<!-- TRENDING TOPICS -->
<section class="trending">
    <div class="section-inner">
        <p class="eyebrow">Browse by Topic</p>
        @if (!Model.Genres.Any())
        {
            <p>No topics yet.</p>
        }
        else
        {
            <div class="topic-list">
                @foreach (var genre in Model.Genres)
                {
                    <a href="/genre/@genre.ID" class="topic-pill">@genre.NameGenre</a>
                }
            </div>
        }
    </div>
</section>

<!-- QUOTE BANNER -->
<section class="quote-banner">
    <p>"Every opinion matters when it is supported by facts."</p>
</section>

<!-- CONTACT -->
<section class="contact" id="contact">
    <div class="section-inner contact-grid">
        <div class="contact-heading">
            <p class="eyebrow">Contact</p>
            <h2>Let's talk</h2>
        </div>
    </div>
</section>
