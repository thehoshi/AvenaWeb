<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Avena</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/Azpetrol.css" asp-append-version="true" />
</head>

<body>

    <header class="navbar">
        <div class="nav-inner">
            <a asp-page="/Index" class="logo">
                <span class="logo-mark">§</span>
                <span class="logo-text">Avena</span>
            </a>

            <nav class="nav-links" id="navLinks">
                <a asp-page="/Index">Home</a>
                <a asp-page="/Index" asp-fragment="news">News</a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-page="/Profile">Profile</a>

                    <form method="post" asp-page="/Logout">
                        <button type="submit">Logout</button>
                    </form>
                }
                else
                {
                    <a asp-page="/Login">Login</a>
                    <a asp-page="/Register">Register</a>
                }
            </nav>

            <button class="nav-toggle" type="button" id="navToggle" aria-label="Open menu" aria-expanded="false">
                <span></span><span></span><span></span>
            </button>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="section-inner footer-inner">
            <p class="footer-copy">Avena © 2026</p>
            <div class="footer-links">
                <a asp-page="/Privacy">Privacy Policy</a>
                <a asp-page="/Terms">Terms</a>
                <a href="https://www.instagram.com/avena_global" target="_blank" rel="noopener noreferrer">Instagram</a>
                <a href="https://vt.tiktok.com/ZSCyaFWtB/" target="_blank" rel="noopener noreferrer">TikTok</a>
            </div>
        </div>
    </footer>

    <script>
            const navToggle = document.getElementById("navToggle");
            const navLinks = document.getElementById("navLinks");

            navToggle.addEventListener("click", function() {
                const isOpen = navLinks.classList.toggle("open");
                navToggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
            });

            document.addEventListener("click", function(event) {
                if (!navToggle.contains(event.target) &&
                    !navLinks.contains(event.target)) {
                    navLinks.classList.remove("open");
                    navToggle.setAttribute("aria-expanded", "false");
                }
            });
    </script>

</body>
</html>
