<!DOCTYPE html>
<html lang="en" data-theme="light" data-language="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#112250" />
    <title>@ViewData["Title"] - Avena</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="shortcut icon" href="~/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/Azpetrol.css" asp-append-version="true" />
</head>
<body>
    <header class="navbar">
        <div class="nav-inner">
            <a asp-page="/Index" class="logo" aria-label="Avena home">
                <span class="logo-mark" aria-hidden="true">A</span>
                <span class="logo-text">Avena</span>
            </a>
            <nav class="nav-links" id="navLinks">
                <a asp-page="/Index" data-i18n="nav.home">Home</a>
                <a asp-page="/Index" asp-fragment="news" data-i18n="nav.news">News</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-page="/Profile" data-i18n="nav.profile">Profile</a>
                    <form method="post" asp-page="/Logout">
                        <button type="submit" data-i18n="nav.logout">Logout</button>
                    </form>
                }
                else
                {
                    <a asp-page="/Login" data-i18n="nav.login">Login</a>
                }
                <div class="nav-tools" aria-label="Site preferences">
                    <button type="button" class="icon-control" id="themeToggle" aria-label="Toggle theme" title="Toggle theme">☾</button>
                    <label class="language-control">
                        <span class="sr-only">Language</span>
                        <select id="languageSelect" aria-label="Language">
                            <option value="en">EN</option>
                            <option value="ru">RU</option>
                            <option value="az">AZ</option>
                        </select>
                    </label>
                </div>
            </nav>
            <button class="nav-toggle" type="button" id="navToggle" aria-label="Open menu" aria-expanded="false">
                <span></span><span></span><span></span>
            </button>
        </div>
    </header>
    <main>@RenderBody()</main>
    <footer class="footer">
        <div class="section-inner footer-inner">
            <p class="footer-copy" data-i18n="footer.copy">Avena © 2026</p>
            <div class="footer-links">
                <a asp-page="/Privacy" data-i18n="footer.privacy">Privacy Policy</a>
                <a asp-page="/Terms" data-i18n="footer.terms">Terms</a>
                <a href="https://www.instagram.com/avena_global" target="_blank" rel="noopener noreferrer">Instagram</a>
                <a href="https://vt.tiktok.com/ZSCyaFWtB/" target="_blank" rel="noopener noreferrer">TikTok</a>
            </div>
        </div>
    </footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
