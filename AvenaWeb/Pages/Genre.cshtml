@page "/genre/{id:int}"
@model GenreModel

@{
    ViewData["Title"] = Model.Genre?.NameGenre;
}

<section class="genre-page">
    <div class="section-inner">
        <div class="genre-header">
            <p class="eyebrow" data-i18n="article.genre">Genre</p>
            <h1 data-genre="@Model.Genre?.NameGenre">@Model.Genre?.NameGenre</h1>
        </div>

        @if (!Model.News.Any())
        {
            <p data-i18n="genre.empty">No articles in this genre yet.</p>
        }
        else
        {
            <div class="news-grid">
                @foreach (var news in Model.News)
                {
                    var excerpt = news.Info.Length > 140 ? news.Info.Substring(0, 140).TrimEnd() + "…" : news.Info;

                    <article class="news-card">
                        @if (!string.IsNullOrEmpty(news.Image))
                        {
                            <div class="card-image" style="background-image:url('@news.Image'); background-size:cover; background-position:center; border-radius:4px;"></div>
                        }
                        else
                        {
                            <div class="card-image ph-img" data-label="Image"></div>
                        }
                        <h4><a href="/news/@news.ID">@news.Title</a></h4>
                        <p>@excerpt</p>
                        <p class="genre-card-meta"><span class="localized-date" data-date="@news.DateOfPost.ToString("o")"></span> · <span class="localized-views" data-count="@news.Views"></span></p>
                        <a href="/news/@news.ID" class="read-more"><span data-i18n="common.read_more">Read More</span> <span aria-hidden="true">→</span></a>
                    </article>
                }
            </div>
        }
    </div>
</section>
